{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flex-mcp",
  "main": "apps/mcp-server/worker/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "exports": {
    "FlexBridge": { "type": "durable-object", "storage": "sqlite" }
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "durable_objects": {
        "bindings": [{ "name": "BRIDGE", "class_name": "FlexBridge" }]
      }
    },
    "production": {
      "name": "flex-mcp",
      "workers_dev": false,
      "routes": [{ "pattern": "flex-mcp.freevue.dev", "custom_domain": true }],
      "vars": { "FLEX_PUBLIC_ORIGIN": "https://flex-mcp.freevue.dev" },
      "durable_objects": {
        "bindings": [{ "name": "BRIDGE", "class_name": "FlexBridge" }]
      }
    }
  }
}
