{
  "name": "@flex-mcp/chrome-extension",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit false && node package-build.mjs",
    "check": "tsc && tsc -p tsconfig.test.json",
    "prebuild": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7"
  }
}
