{
  "name": "flex-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "pnpm --filter @flex-mcp/server run dev",
    "build": "pnpm -r run build",
    "build:mcp": "pnpm --filter @flex-mcp/server run build",
    "build:extension": "pnpm --filter @flex-mcp/chrome-extension run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r run --if-present test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
